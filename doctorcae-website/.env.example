# Copy to .env.local for local testing with: npx vercel dev
# In Vercel: Project → Settings → Environment Variables (Production + Preview).

# Supabase (server only — never prefix with NEXT_PUBLIC_ or put in static HTML)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — API key stays on the server only
RESEND_API_KEY=
# e.g. "Dr. Cae <hello@your-verified-domain.com>"
RESEND_FROM=
# Preferred alias used by toolkit flow (falls back to RESEND_FROM)
RESEND_FROM_EMAIL=

# Public URL included in the welcome email (thank-you page or direct PDF link)
FREE_GUIDE_DOWNLOAD_URL=

# Toolkit sample flow
TOOLKIT_SAMPLE_PAGE_URL=
TOOLKIT_SAMPLE_DOWNLOAD_URL=
TOOLKIT_FULL_PODIA_URL=
FORMSPREE_TOOLKIT_ENDPOINT=

# Admin — AI social post generator (/api/generate-post). Optional: OPENAI_MODEL (default gpt-4o-mini)
OPENAI_API_KEY=
